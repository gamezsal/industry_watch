# Agent Platform Configuration Template
# Copy this file to .env and replace placeholders with your actual Google Cloud values:
# cp .env.example .env

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT_NUMBER=your-gcp-project-number
GOOGLE_CLOUD_AGENT_ENGINE_ID=your-agent-engine-id
VERTEX_AI_SANDBOX_ID=your-sandbox-id
MODEL_ARMOR_TEMPLATE_ID=industry-watch-armor-template
GOOGLE_GENAI_USE_VERTEXAI=True
